# Local SQLite (default)
DATABASE_URL="file:./dev.db"

ADMIN_PASSWORD="admin123"
NEXTAUTH_URL="http://localhost:3000"
DEMO_AUTH="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Protects /api/cron/update-tools (Authorization: Bearer <secret> or x-cron-secret)
CRON_SECRET=
# Dev-only: allow cron without CRON_SECRET when set to true (never in production)
ALLOW_INSECURE_CRON="false"

# --- Production DB (Vercel) — Turso / libSQL (recommended, keeps sqlite Prisma provider) ---
# Create a DB at https://turso.tech (free tier), then:
# TURSO_DATABASE_URL="libsql://your-db-name-user.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."
# For `prisma db push` against Turso you can also set:
# DATABASE_URL="libsql://your-db-name-user.turso.io?authToken=eyJ..."
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Alternative: Neon Postgres ---
# Change prisma/schema.prisma datasource provider to "postgresql", then:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Leave TURSO_* empty when using Neon.
